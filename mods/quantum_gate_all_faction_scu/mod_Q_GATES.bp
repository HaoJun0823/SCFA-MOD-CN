	Merge = true,
	BlueprintId="urb0304", # CYBRAN_QUANTUM_GATE

    Economy = {
        BuildableCategory = {
            'BUILTBYQUANTUMGATE MOBILE LAND',
            'BUILTBYQUANTUMGATE MOBILE AIR',
            'SUBCOMMANDER',
            'TECH3 ENGINEER LAND',   # 四族「陆军」T3 工程师（0309，带 LAND）；排除海军工程师船（带 NAVAL 不带 LAND）。SCU(0301) 也带 LAND，仍由 SUBCOMMANDER 兜底
        },
	},
}

